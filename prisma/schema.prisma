generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  plan      String   @default("free") // "free" ou "premium"
  status    String   @default("inactive") // "inactive", "active"
  initialBalance Float @default(0)
  initialBalanceActivity Float @default(0)
  role      String   @default("user") // "super_admin", "admin", "user"
  currency        String   @default("XOF") // displayCurrency — modifiable dans paramètres
  baseCurrency    String   @default("XOF") // devise figée à l'inscription
  countryCode     String?                  // BJ, TG, BF, CI, FR, BE
  phone           String?                  // numéro de téléphone
  avatarUrl       String?  @db.Text          // base64 image (256x256 WebP)
  emailVerified DateTime?
  loginAttempts Int      @default(0)
  lockedUntil   DateTime?
  activityActivated Boolean @default(false)
  tontineAccess     Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions       Transaction[]
  categories         Category[]
  products           Product[]
  sales              Sale[]
  stockMovements     StockMovement[]
  reports            Report[]
  subscription       Subscription?
  subscriptionHistory SubscriptionHistory[]
  verificationTokens VerificationToken[]
  loginLogs          LoginLog[]
  sessions           Session[]
  notifications           Notification[]              @relation("UserNotifications")
  actedNotifications       Notification[]              @relation("NotificationActor")
  recurringTemplates       RecurringTemplate[]
  budgets                  Budget[]
  adminNotificationPref    String                      @default("instant") // "instant" ou "digest"
  notificationPrefs        Json                        @default("{}")
  onboardingCompleted      Boolean                     @default(false)

  tontines                      Tontine[]
}

model VerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  type      String   @default("email_verification")
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model LoginLog {
  id        Int      @id @default(autoincrement())
  ip        String   @default("")
  userAgent String   @default("")
  success   Boolean  @default(false)
  reason    String   @default("")
  createdAt DateTime @default(now())
  userId    Int?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model Session {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress  String   @default("")
  userAgent  String   @default("")
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String   // "subscription", "product", "sale", "stock", "admin", "role", "system"
  message   String
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    Int      // destinataire
  actorId   Int?     // qui a fait l'action

  user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([createdAt])
}

model PendingAdminEmail {
  id        Int      @id @default(autoincrement())
  type      String   // "new_registration", "new_subscription", "subscription_expired"
  data      String   // JSON string — contextual data about the event
  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@index([sentAt])
}

model Subscription {
  id        Int      @id @default(autoincrement())
  status    String   @default("active") // "active", "cancelled", "expired"
  provider  String   @default("")
  method    String   @default("")
  amount    Float    @default(5000)
  currency  String   @default("XOF")
  startDate DateTime @default(now())
  endDate   DateTime
  notifiedAt7Days  Boolean @default(false)
  notifiedAt3Days  Boolean @default(false)
  notifiedAtExpiry Boolean @default(false)
  weeklyReminderCount Int  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int      @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SubscriptionHistory {
  id        Int      @id @default(autoincrement())
  status    String
  provider  String   @default("")
  method    String   @default("")
  amount    Float    @default(5000)
  currency  String   @default("XOF")
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  userId    Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id       Int    @id @default(autoincrement())
  name     String
  icon     String @default("")
  type     String // "income" or "expense"
  archived Boolean @default(false)
  userId   Int

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  recurringTemplates RecurringTemplate[]
  budgets            Budget[]

  @@unique([name, userId])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        String   // "income" or "expense"
  amount      Float
  description String
  date        DateTime @default(now())
  scope       String   @default("personal") // "personal" or "activity"
  recurring   Boolean  @default(false)
  categoryId  Int?
  userId      Int
  tontineCotisationId Int?   @unique

  category  Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tontineCotisation TontineCotisation? @relation("TontineCommission", fields: [tontineCotisationId], references: [id])
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  purchasePrice Float    @default(0)
  salePrice     Float    @default(0)
  stock         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        Int

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales          Sale[]
  stockMovements StockMovement[]
}

model Sale {
  id        Int      @id @default(autoincrement())
  quantity  Int      @default(1)
  unitPrice Float
  totalAmount Float
  profit    Float    @default(0)
  date      DateTime @default(now())
  productId Int
  userId    Int

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  type      String   // "in" or "out"
  quantity  Int
  date      DateTime @default(now())
  description String @default("")
  productId Int
  userId    Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id        Int      @id @default(autoincrement())
  type      String   // "weekly", "monthly", "yearly"
  data      String   // JSON string
  periodStart DateTime
  periodEnd   DateTime
  createdAt DateTime @default(now())
  userId    Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecurringTemplate {
  id         Int      @id @default(autoincrement())
  name       String
  amount     Float
  type       String   // "income" or "expense"
  scope      String   @default("personal") // "personal" or "activity"
  dayOfMonth Int      // 1-31
  categoryId Int?
  active     Boolean  @default(true)
  userId     Int

  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model Budget {
  id         Int    @id @default(autoincrement())
  categoryId Int
  scope      String @default("personal") // "personal" or "activity"
  amount     Float
  month      Int    // 1-12
  year       Int
  userId     Int

  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, scope, month, year])
  @@index([userId, month, year])
}

model Tontine {
  id                        Int       @id @default(autoincrement())
  nom                       String
  organisateurId            Int
  type                      String    // "rotative_simple" ou "vivres_fin_annee"
  montantCotisation         Float
  frequence                 String    // nombre de jours entre chaque cotisation (ex: "1", "5", "7", "30")
  dateDebut                 DateTime
  fraisOrganisateurParDefaut Float    @default(0)
  scopeCommission           String    @default("activite") // "activite" ou "personnel"
  nombreTours               Int?
  dateDistribution          DateTime?
  statut                    String    @default("active") // "active", "terminee", "suspendue"
  penaliteRetardActive      Boolean   @default(false)
  penaliteRetardMontant     Float     @default(0)
  penaliteRetardDelaiJours  Int       @default(3)
  nbPersonnesPrevue         Int?

  organisateur User                    @relation(fields: [organisateurId], references: [id], onDelete: Cascade)
  membres      TontineMembre[]
  cotisations  TontineCotisation[]
  tours        TontineTour[]
  distribution TontineDistribution?
}

model TontineMembre {
  id           Int      @id @default(autoincrement())
  tontineId    Int
  nom          String
  contact      String?
  ordrePassage Int?
  statut       String   @default("actif") // "actif", "retire", "exclu"
  soldeAvance  Float    @default(0)
  montantCotisationPersonnel Float?

  tontine     Tontine              @relation(fields: [tontineId], references: [id], onDelete: Cascade)
  cotisations TontineCotisation[]
}

model TontineCotisation {
  id                Int       @id @default(autoincrement())
  tontineId         Int
  membreId          Int
  periode           DateTime
  montantBase       Float     // part qui va dans la cagnotte commune
  fraisOrganisateur Float     @default(0) // commission organisateur
  montantTotal      Float     // montantBase + fraisOrganisateur
  montantPaye       Float     @default(0)
  montantPenalite   Float     @default(0) // pénalité de retard appliquée
  datePaiement      DateTime?
  statut            String    @default("en_attente") // "paye", "en_retard", "partiel", "en_attente"
  imputee           Boolean   @default(false) // vraie si la période a été matérialisée/remplie par imputation de surplus

  tourId            Int?
  tontine   Tontine       @relation(fields: [tontineId], references: [id], onDelete: Cascade)
  membre    TontineMembre @relation(fields: [membreId], references: [id], onDelete: Cascade)
  tour      TontineTour?  @relation(fields: [tourId], references: [id], onDelete: SetNull)
  commissionTransaction Transaction? @relation("TontineCommission")
}

model TontineTour {
  id              Int      @id @default(autoincrement())
  tontineId       Int
  numeroTour      Int
  datePrevue      DateTime
  beneficiaireId  Int
  montantAttendu  Float
  montantCollecte Float    @default(0)
  statut          String   @default("en_cours") // "planifie", "en_cours", "collecte_terminee", "cloture"

  tontine Tontine @relation(fields: [tontineId], references: [id], onDelete: Cascade)
  cotisations TontineCotisation[]
}

model TontineDistribution {
  id                   Int      @id @default(autoincrement())
  tontineId            Int      @unique
  dateDistribution     DateTime
  dateLimiteCotisation DateTime? // dernière date pour cotiser
  montantTotalCollecte Float    @default(0)
  montantAlloueVivres  Float    @default(0)
  montantAlloueArgent  Float    @default(0)
  statut               String   @default("planifiee") // "planifiee", "collecte_terminee", "effectuee"

  tontine Tontine @relation(fields: [tontineId], references: [id], onDelete: Cascade)
}
